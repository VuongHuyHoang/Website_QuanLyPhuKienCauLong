@model List<WebsiteBanPhuKienCauLong_65131148.Models.HangHoa>
@{
    ViewBag.Title = "TrangChu";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<div id="carouselExample" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/Images/banner1.png" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item">
            <img src="~/Images/banner2.png" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item">
            <img src="~/Images/banner3.png" class="d-block w-100" alt="...">
        </div>
        <div class="carousel-item">
            <img src="~/Images/banner4.png" class="d-block w-100" alt="...">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>
<!-- Promo_box-->
<div class="container my-4">
    <div class="row g-3">

        <!-- Box 1 -->
        <div class="col-lg-3 col-md-6">
            <div class="promo-box d-flex align-items-center">
                <i class="bi bi-truck promo-icon"></i>
                <div>
                    <h6 class="promo-title">Vận chuyển TOÀN QUỐC</h6>
                    <p class="promo-text">Thanh toán khi nhận hàng</p>
                </div>
            </div>
        </div>

        <!-- Box 2 -->
        <div class="col-lg-3 col-md-6">
            <div class="promo-box d-flex align-items-center">
                <i class="bi bi-patch-check promo-icon"></i>
                <div>
                    <h6 class="promo-title">Bảo đảm chất lượng</h6>
                    <p class="promo-text">Sản phẩm bảo đảm chất lượng</p>
                </div>
            </div>
        </div>

        <!-- Box 3 -->
        <div class="col-lg-3 col-md-6">
            <div class="promo-box d-flex align-items-center">
                <i class="bi bi-credit-card promo-icon"></i>
                <div>
                    <h6 class="promo-title">Tiến hành THANH TOÁN</h6>
                    <p class="promo-text">PHƯƠNG THỨC THANH TOÁN COD</p>
                </div>
            </div>
        </div>

        <!-- Box 4 -->
        <div class="col-lg-3 col-md-6">
            <div class="promo-box d-flex align-items-center">
                <i class="bi bi-arrow-repeat promo-icon"></i>
                <div>
                    <h6 class="promo-title">Đổi sản phẩm mới</h6>
                    <p class="promo-text">Nếu sản phẩm lỗi</p>
                </div>
            </div>
        </div>

    </div>
</div>


<div class="container my-4">

    <div class="text-center">
        <h3 class="section-title">Sản phẩm nổi bật</h3>
        <div class="title-underline"></div>
    </div>

    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-inner">

            @for (int i = 0; i < Model.Count; i += 5)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="row g-3 align-items-stretch">

                        @for (int j = i; j < i + 5 && j < Model.Count; j++)
                        {
                            var sp = Model[j];
                            <div class="col">
                                <div class="product-card h-100 d-flex flex-column text-center">

                                    <a href="@Url.Action("Details",new {id = sp.maHangHoa})">
                                        <img src="~/images/@sp.anh"
                                             class="img-fluid product-img">
                                    </a>

                                    <p class="title flex-grow-1">
                                        @sp.tenHangHoa
                                    </p>

                                    <span class="price text-danger fw-bold">
                                        @string.Format("{0:N0} đ", sp.gia)
                                    </span>

                                </div>
                            </div>
                        }

                    </div>
                </div>
            }

        </div>


        <!-- Controls -->
        <button class="carousel-control-prev" type="button"
                data-bs-target="#productCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#productCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>

