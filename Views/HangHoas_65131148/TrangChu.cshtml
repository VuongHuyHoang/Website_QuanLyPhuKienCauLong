<section class="section-partner-consult">

    <section class="partner-section-modern">
        <div class="bg-pattern"></div>

        <div class="container position-relative z-2">
            <div class="brand-container-modern">

                <div class="brand-center-content text-center">
                    <div class="badge-custom mb-3 shadow-lg">
                        <i class="bi bi-trophy-fill me-2"></i>Thiên Hương Badminton
                    </div>
                    <h2 class="fw-bold display-6 mb-2">Đối tác chiến lược</h2>
                    <p class="text-muted">Tự hào phân phối chính hãng các thương hiệu<br>hàng đầu thế giới.</p>
                </div>

                <div class="brand-floating-card pos-1">
                    <img src="~/images/logo-yonex.png" alt="Yonex">
                </div>
                <div class="brand-floating-card pos-2">
                    <img src="~/images/logo-lining.png" alt="Lining">
                </div>
                <div class="brand-floating-card pos-3">
                    <img src="~/images/logo-victor.png" alt="Victor">
                </div>
                <div class="brand-floating-card pos-4">
                    <img src="~/images/logo-vnb.png" alt="VNB">
                </div>
                <div class="brand-floating-card pos-5">
                    <img src="~/images/logo-kawasaki.png" alt="Kawasaki">
                </div>

                <div class="deco-dot dot-1"></div>
                <div class="deco-dot dot-2"></div>
                <div class="deco-dot dot-3"></div>
                

            </div>
        </div>
    </section>

    <div class="container mt-5">
        <div class="row align-items-center">

            <div class="col-md-6 offset-md-1">
                <h4 class="fw-bold mb-4 text-dark">Đăng ký tư vấn ngay</h4>

                <form action="@Url.Action("TrangLienHe", "HangHoas_65131148")" method="post">

                    <div class="form-group">
                        <input type="text" name="hoTen" class="form-control form-consult-input" placeholder="Nhập họ tên của bạn" required>
                    </div>
                    <div class="form-group">
                        <input type="text" name="sdt" class="form-control form-consult-input" placeholder="Nhập số điện thoại của bạn" required>
                    </div>
                    <div class="form-group">
                        <input type="email" name="email" class="form-control form-consult-input" placeholder="Nhập email của bạn">
                    </div>
                    <div class="form-group">
                        @Html.AntiForgeryToken() <input type="text" name="tieuDe" class="form-control form-consult-input" placeholder="Tiêu đề (VD: Tư vấn vợt, Bảo hành...)" required>
                    </div>
                    <div class="form-group">
                        <textarea name="noiDung" class="form-control form-consult-input" rows="3" style="border-radius: 20px;" placeholder="Nhập nội dung yêu cầu (nếu có)"></textarea>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-consult-submit">
                            <i class="bi bi-send-fill me-2"></i> Gửi đi
                        </button>
                    </div>
                </form>
            </div>

            <div class="col-md-4 text-center position-relative">
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 600px; height: 600px; background: #ffece5; border-radius: 50%; z-index: -1;"></div>

                <img src="~/images/anhhotro.png" alt="Tư vấn cầu lông" class="deco-shuttlecock img-fluid" style="transform: rotate(15deg);">
            </div>
        </div>
    </div>

</section>

<style>
    /* Tiêu đề phần sản phẩm */
    .section-title {
        color: #f15a22;
        font-weight: bold;
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 30px;
    }

    .title-underline {
        width: 60px;
        height: 4px;
        background-color: #f15a22;
        margin: 10px auto;
    }

    /* Khung ô vuông danh mục */
    .category-item {
        position: relative;
        aspect-ratio: 1 / 1; /* Giữ ô luôn là hình vuông */
        background: radial-gradient(circle, #ffb74d, #fb8c00); /* Nền cam gradient */
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
        cursor: pointer;
        border: none;
    }

        .category-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        /* Ảnh sản phẩm */
        .category-item img {
            max-width: 85%;
            max-height: 85%;
            object-fit: contain;
            z-index: 1;
        }

    /* Nhãn tên danh mục (Cái ruy băng nghiêng) */
    .category-label {
        position: absolute;
        bottom: 25%;
        left: -15%;
        width: 130%;
        background-color: #d84315; /* Màu đỏ cam đậm */
        color: white;
        padding: 8px 0;
        text-align: center;
        font-weight: bold;
        font-size: 14px;
        transform: rotate(-15deg); /* Làm nghiêng nhãn */
        z-index: 2;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        text-transform: uppercase;
        pointer-events: none;
    }

    /* Các họa tiết trang trí (Dấu cộng, hình tròn nhỏ) */
    .category-item::before {
        content: "+";
        position: absolute;
        top: 10px;
        right: 15px;
        color: rgba(255,255,255,0.6);
        font-size: 20px;
    }
    /* --- SECTION WRAPPER --- */
.section-partner-consult {
    position: relative;
    background-color: #fff;
    padding-top: 80px;
    padding-bottom: 80px;
    overflow: hidden;
}

/* --- TỔNG THỂ SECTION --- */
    .partner-section-modern {
        position: relative;
        padding: 100px 0; /* Tăng chiều cao để thoáng hơn */
        background: radial-gradient(ellipse at left center, #ffc4a4 0%, transparent 60%), radial-gradient(ellipse at right center, #ffc4a4 0%, transparent 60%);
        overflow: hidden;
    }

/* Họa tiết lưới (Grid Pattern) làm nền - Giúp lấp khoảng trống */
.bg-pattern {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 30px 30px; /* Kích thước ô lưới */
    opacity: 0.5;
    z-index: 1;
}

/* Hiệu ứng mờ dần ở trung tâm để làm nổi bật chữ */
.partner-section-modern::after {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 70%);
    z-index: 1;
    border-radius: 50%;
}

.brand-container-modern {
    position: relative;
    height: 400px; /* Tăng chiều cao vùng chứa */
    display: flex;
    align-items: center;
    justify-content: center;
}

/* --- TRUNG TÂM --- */
.brand-center-content {
    position: relative;
    z-index: 10;
    max-width: 500px;
}

/* Badge (Cái nhãn Badminton) đẹp hơn */
.badge-custom {
    display: inline-block;
    padding: 10px 25px;
    background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); /* Gradient Cam Vàng */
    color: white;
    font-weight: bold;
    border-radius: 50px;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
}

/* --- CÁC THẺ LOGO (GLASSMORPHISM) --- */
.brand-floating-card {
    position: absolute;
    width: 90px; height: 90px; /* To hơn chút */
    background: rgba(255, 255, 255, 0.8); /* Nền trắng trong suốt */
    backdrop-filter: blur(10px); /* Hiệu ứng kính mờ */
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05); /* Đổ bóng nhẹ */
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s ease;
    animation: floatUpDown 6s ease-in-out infinite;
    z-index: 5;
    cursor: pointer;
}

.brand-floating-card img {
    max-width: 70%;
    max-height: 70%;
    object-fit: contain;
}



/* --- VỊ TRÍ CÁC LOGO (Sắp xếp hình Elip bao quanh text) --- */
/* Bên Trái */
.pos-1 { top: 10%; left: 15%; animation-delay: 0s; }
.pos-2 { top: 60%; left: 5%; animation-delay: 1.5s; width: 80px; height: 80px; } /* Nhỏ hơn xíu tạo chiều sâu */

/* Bên Phải */
.pos-3 { top: 15%; right: 15%; animation-delay: 2s; }
.pos-4 { top: 55%; right: 5%; animation-delay: 0.5s; width: 80px; height: 80px;}

/* Ở Dưới cùng */
.pos-5 { bottom: -10%; left: 45%; animation-delay: 3s; width: 70px; height: 70px;}


/* --- CÁC CHẤM TRANG TRÍ (DECO DOTS) --- */
.deco-dot {
    position: absolute;
    border-radius: 50%;
    background-color: #f15a22;
    opacity: 0.2;
    animation: pulse 3s infinite;
}
.dot-1 { width: 15px; height: 15px; top: 20%; left: 40%; background: #3b82f6; }
.dot-2 { width: 10px; height: 10px; bottom: 30%; right: 30%; }
.dot-3 { width: 20px; height: 20px; top: 10%; right: 10%; opacity: 0.1; }


/* --- ANIMATION --- */
@@keyframes floatUpDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

@@keyframes pulse {
    0% { transform: scale(1); opacity: 0.2; }
    50% { transform: scale(1.5); opacity: 0.1; }
    100% { transform: scale(1); opacity: 0.2; }
}

/* Mobile: Ẩn bớt hiệu ứng bay lượn, xếp thành lưới */
@@media (max-width: 768px) {
    .brand-container-modern {
        height: auto;
        flex-direction: column;
        padding: 40px 0;
    }
    .brand-floating-card {
        position: relative;
        display: inline-flex;
        margin: 10px;
        top: auto !important; left: auto !important; right: auto !important; bottom: auto !important;
        animation: none;
        width: 70px; height: 70px;
    }
    .pos-1, .pos-2, .pos-3, .pos-4, .pos-5 { transform: none; }
}

/* --- PHẦN 2: FORM TƯ VẤN --- */
.form-consult-input {
    border-radius: 50px; /* Bo tròn như hình */
    padding: 12px 20px;
    border: 1px solid #dee2e6;
    margin-bottom: 15px;
    background-color: #f9f9f9;
}

.form-consult-input:focus {
    background-color: #fff;
    box-shadow: none;
    border-color: #f26522; /* Màu cam chủ đạo */
}

.btn-consult-submit {
    background-color: #f26522;
    color: white;
    border-radius: 50px;
    padding: 10px 40px;
    font-weight: bold;
    border: none;
    transition: all 0.3s;
}

.btn-consult-submit:hover {
    background-color: #d95316;
    transform: translateY(-2px);
    color: white;
}

/* Hình trang trí cầu lông bên phải */
    .deco-shuttlecock {
        width: 100%; /* Để ảnh chiếm hết chiều rộng container */
        max-width: 500px;
        height: auto;
        filter: drop-shadow(0 10px 15px rgba(242, 101, 34, 0.2));
    }

/* Responsive: Ẩn logo bay trên mobile cho đỡ rối */
@@media (max-width: 768px) {
    .brand-box { display: none; }
    .brand-container { height: auto; padding: 30px 0; }
}
</style>



