@model IEnumerable<WebsiteBanPhuKienCauLong_65131148.Models.DonHang>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase"><i class="bi bi-box-seam me-2"></i>Lịch sử mua hàng</h2>
        <a href="@Url.Action("TrangSanPham", "HangHoas_65131148")" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua sắm
        </a>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.maDonHang</td>
                                <td class="">@item.ngayDat</td>
                                <td class="text-danger fw-bold">
                                    @(item.tongTien?.ToString("N0") ?? "0") ₫
                                </td>
                                <td>
                                    @if (item.trangThai == "Chờ xử lý")
                                    {
                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    }
                                    else if (item.trangThai == "Đang giao")
                                    {
                                        <span class="badge bg-primary">Đang giao</span>
                                    }
                                    else if (item.trangThai == "Hoàn thành")
                                    {
                                        <span class="badge bg-success">Hoàn thành</span>
                                    }
                                    else if (item.trangThai == "Đã hủy")
                                    {
                                        <span class="badge bg-secondary">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.trangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("ChiTietDonHang", "HangHoas_65131148", new { id = item.maDonHang })"
                                       class="btn btn-sm btn-outline-dark px-3 rounded-pill shadow-sm">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3 mt-2">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">

                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-circle mx-1 border-0" href="@Url.Action("DonHang", new { page = ViewBag.CurrentPage - 1 })" aria-label="Previous">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1 border-0 @(i == ViewBag.CurrentPage ? "bg-primary text-white shadow" : "text-dark")"
                                       href="@Url.Action("DonHang", new { page = i })">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-circle mx-1 border-0" href="@Url.Action("DonHang", new { page = ViewBag.CurrentPage + 1 })" aria-label="Next">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x fs-1 text-muted opacity-50"></i>
                <p class="mt-3 text-muted fw-bold">Bạn chưa có đơn hàng nào.</p>
                <a href="@Url.Action("TrangSanPham", "HangHoas_65131148")" class="btn btn-primary rounded-pill px-4">
                    Mua sắm ngay
                </a>
            </div>
        }
    </div>
</div>