@model List<WebsiteBanPhuKienCauLong_65131148.Models.HangHoa>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";

    var selectedHangs = ViewBag.maHang as List<int>;
    var selectedDanhMucs = ViewBag.maDanhMuc as List<int>;
    var giaMin = ViewBag.giaMin;
    var giaMax = ViewBag.giaMax;
    var sortOrder = ViewBag.SortOrder as string;
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 p-3">
                <form id="filterForm" method="get" action="@Url.Action("TrangSanPham", "HangHoas_65131148")">

                    <input type="hidden" name="sortOrder" id="hiddenSortOrder" value="@sortOrder" />

                    <h6 class="fw-bold mb-3"><i class="bi bi-tag-fill me-2"></i>THƯƠNG HIỆU</h6>
                    <div class="filter-group mb-3" style="max-height: 200px; overflow-y: auto;">
                        @if (ViewBag.Hangs != null)
                        {
                            foreach (var hang in ViewBag.Hangs)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" name="maHang" value="@hang.maHang"
                                           @(selectedHangs != null && selectedHangs.Contains(hang.maHang) ? "checked" : "") />
                                    <label class="form-check-label px-1">@hang.tenHang</label>
                                </div>
                            }
                        }
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>DANH MỤC</h6>
                    <div class="filter-group mb-3">
                        @if (ViewBag.DanhMucs != null)
                        {
                            foreach (var dm in ViewBag.DanhMucs)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" name="maDanhMuc" value="@dm.maDanhMuc"
                                           @(selectedDanhMucs != null && selectedDanhMucs.Contains(dm.maDanhMuc) ? "checked" : "") />
                                    <label class="form-check-label px-1">@dm.tenDanhMuc</label>
                                </div>
                            }
                        }
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3"><i class="bi bi-currency-dollar me-2"></i>KHOẢNG GIÁ</h6>
                    <div class="mb-2">
                        <input type="number" name="giaMin" value="@giaMin" class="form-control form-control-sm mb-2" placeholder="Giá từ (đ)" />
                        <input type="number" name="giaMax" value="@giaMax" class="form-control form-control-sm mb-3" placeholder="Đến giá (đ)" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 shadow-sm">
                        <i class="bi bi-filter me-1"></i> Lọc sản phẩm
                    </button>

                    <a href="@Url.Action("TrangSanPham", "HangHoas_65131148")" class="btn btn-outline-secondary btn-sm w-100 mt-2">
                        Xóa tất cả bộ lọc
                    </a>
                </form>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0 text-uppercase text-primary">Sản phẩm hiện có</h5>
                <small class="text-muted">Hiển thị tối đa 20 sản phẩm/trang</small>
            </div>

            <div class="d-flex align-items-center">
                <label class="me-2 small text-muted text-nowrap">Sắp xếp theo:</label>
                <select class="form-select form-select-sm border-secondary" style="width: 180px;" onchange="submitSort(this.value)">
                    <option value="">Mặc định</option>
                    <option value="gia_tang" @(sortOrder == "gia_tang" ? "selected" : "")>Giá: Thấp đến Cao</option>
                    <option value="gia_giam" @(sortOrder == "gia_giam" ? "selected" : "")>Giá: Cao đến Thấp</option>
                    <option value="ten_az" @(sortOrder == "ten_az" ? "selected" : "")>Tên: A - Z</option>
                    <option value="ten_za" @(sortOrder == "ten_za" ? "selected" : "")>Tên: Z - A</option>
                </select>
            </div>

            <div class="row g-4 mt-2">
                @if (Model != null && Model.Any())
                {
                    foreach (var sp in Model)
                    {
                        // Kiểm tra an toàn null cho danh sách size
                        var listSize = sp.HangHoa_Size != null ? sp.HangHoa_Size : new List<WebsiteBanPhuKienCauLong_65131148.Models.HangHoa_Size>();
                        bool coSize = listSize.Any(x => x.soLuongTon > 0);

                        // Tạo JSON dữ liệu size an toàn
                        string sizesJson = "[]";
                        if (coSize)
                        {
                            var simpleSizes = listSize.Where(x => x.soLuongTon > 0).Select(s => new
                            {
                                id = s.maSize,
                                name = s.Size != null ? s.Size.tenSize : "Size " + s.maSize,
                                qty = s.soLuongTon
                            });
                            sizesJson = Newtonsoft.Json.JsonConvert.SerializeObject(simpleSizes);
                        }

                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm product-card border-0">
                                <div class="p-3">
                                    <a href="@Url.Action("Details", new {id = sp.maHangHoa})">
                                        <img src="~/images/@sp.anh" class="card-img-top img-fluid"
                                             style="height:160px; object-fit:contain;" alt="@sp.tenHangHoa" />
                                    </a>
                                </div>
                                <div class="card-body p-3 text-center d-flex flex-column justify-content-between">
                                    <h6 class="card-title text-dark mb-2 text-truncate-2" title="@sp.tenHangHoa" style="font-size: 14px; height: 40px; overflow: hidden;">
                                        @sp.tenHangHoa
                                    </h6>
                                    <div>
                                        <p class="text-danger fw-bold mb-0">
                                            @(sp.gia?.ToString("N0") ?? "0") <small>đ</small>
                                        </p>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 pb-3 d-flex justify-content-start ps-3">

                                        @if (coSize)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm rounded-pill px-4 d-inline-flex align-items-center gap-2 text-nowrap btn-open-modal"
                                                    data-id="@sp.maHangHoa"
                                                    data-name="@sp.tenHangHoa"
                                                    data-img="@sp.anh"
                                                    data-price="@(sp.gia ?? 0)"
                                                    data-sizes='@Html.Raw(sizesJson)'
                                                    data-url="@Url.Action("Details", new { id = sp.maHangHoa })">
                                                <i class="bi bi-cart-plus"></i>
                                                <span>Thêm Ngay</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("ThemGioHang", "HangHoas_65131148", new { id = sp.maHangHoa })"
                                               class="btn btn-outline-danger btn-sm rounded-pill px-4 d-inline-flex align-items-center gap-2 text-nowrap">
                                                <i class="bi bi-cart-plus"></i>
                                                <span>Thêm ngay</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center my-5">
                        <p class="text-muted">Không tìm thấy sản phẩm nào phù hợp với bộ lọc.</p>
                    </div>
                }
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <div class="mt-5 d-flex justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <button type="button" class="btn btn-sm mx-1 @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-light border")"
                                onclick="goToPage(@i)">
                            @i
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="sizeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <a id="modalProductLink" href="#" class="text-decoration-none text-dark hover-primary">
                    Tên sản phẩm
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center pt-1">
                <img id="modalProductImg" src="" class="img-fluid mb-3 rounded" style="height: 120px; object-fit: contain;" />
                <p class="text-danger fw-bold h5 mb-3" id="modalProductPrice">0 đ</p>

                <div class="mb-3 text-start">
                    <label class="form-label small text-muted fw-bold">Chọn kích cỡ:</label>
                    <select id="modalSizeSelect" class="form-select">
                    </select>
                </div>

                <button type="button" class="btn btn-danger w-100 fw-bold py-2" onclick="submitAddToCart()">
                    <i class="bi bi-cart-check me-2"></i> THÊM VÀO GIỎ
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Xử lý khi đổi Dropdown Sắp xếp
    function submitSort(value) {
        var hiddenInput = document.getElementById('hiddenSortOrder');
        var form = document.getElementById('filterForm');

        if (hiddenInput && form) {
            hiddenInput.value = value;
            form.submit();
        } else {
            console.error("Lỗi: Không tìm thấy Form Filter hoặc Input SortOrder");
        }
    }

    // Xử lý chuyển trang (Dùng chung form filter để giữ bộ lọc)
    function goToPage(page) {
        var form = document.getElementById('filterForm');
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'page';
        input.value = page;
        form.appendChild(input);
        form.submit();
    }

    // Biến tạm lưu ID sản phẩm
    var currentProductId = 0;

    // 2. Xử lý mở Modal bằng Event Listener (An toàn hơn onclick inline)
    document.addEventListener('DOMContentLoaded', function () {
        var buttons = document.querySelectorAll('.btn-open-modal');

        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                // Lấy dữ liệu từ data-attributes
                currentProductId = this.getAttribute('data-id');
                var name = this.getAttribute('data-name');
                var img = this.getAttribute('data-img');
                var price = parseFloat(this.getAttribute('data-price'));
                var sizes = JSON.parse(this.getAttribute('data-sizes'));
                var url = this.getAttribute('data-url');

                // Điền thông tin vào Modal
                var linkElement = document.getElementById('modalProductLink');
                linkElement.innerText = name;
                linkElement.href = url;
                document.getElementById('modalProductImg').src = '/images/' + img;
                document.getElementById('modalProductPrice').innerText = price.toLocaleString('vi-VN') + ' đ';

                // Xóa options cũ và thêm options mới
                var select = document.getElementById('modalSizeSelect');
                select.innerHTML = '<option value="">-- Chọn Size --</option>';

                sizes.forEach(function (size) {
                    var option = document.createElement('option');
                    option.value = size.id;
                    option.text = size.name + ' (Còn ' + size.qty + ')';
                    select.add(option);
                });

                // Hiển thị Modal
                var myModal = new bootstrap.Modal(document.getElementById('sizeModal'));
                myModal.show();
            });
        });
    });

    // 3. Xử lý nút Thêm vào giỏ trong Modal
    function submitAddToCart() {
        var sizeId = document.getElementById('modalSizeSelect').value;

        if (!sizeId) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Chưa chọn Size', 'Vui lòng chọn kích cỡ bạn muốn mua!', 'warning');
            } else {
                alert('Vui lòng chọn size!');
            }
            return;
        }

        // Chuyển hướng đến Action ThemGioHang
        var url = '@Url.Action("ThemGioHang", "HangHoas_65131148")' + '?id=' + currentProductId + '&maSize=' + sizeId;
        window.location.href = url;
    }
</script>