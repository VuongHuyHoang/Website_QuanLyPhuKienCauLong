@using WebsiteBanPhuKienCauLong_65131148.Models
@model List<Size>

@{
    ViewBag.Title = "Cấu hình kho hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var hangHoa = ViewBag.HangHoa as HangHoa;
    var existingSizes = ViewBag.ExistingSizes as List<HangHoa_Size>;

    // Kiểm tra xem sản phẩm này hiện tại đang có size hay không
    bool dangCoSize = existingSizes != null && existingSizes.Any();
}

<div class="d-flex align-items-center mb-4">
    <a href="@Url.Action("DanhSachSanPham")" class="btn btn-light border rounded-circle me-3 shadow-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h4 class="fw-bold m-0 text-dark">Cấu hình tồn kho</h4>
        <small class="text-muted">Sản phẩm: <span class="text-primary fw-bold">@hangHoa.tenHangHoa</span></small>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body text-center">
                <img src="~/images/@hangHoa.anh" class="img-fluid rounded" style="max-height: 200px;" />
                <h5 class="mt-3">@hangHoa.tenHangHoa</h5>
                <div class="badge bg-warning text-dark mb-2">Hiện đang tồn: @hangHoa.soLuongTon</div>
                <p class="text-muted small">Loại: @(dangCoSize ? "Đang quản lý theo Size" : "Quản lý số lượng chung")</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <i class="bi bi-box-seam me-2 text-primary"></i> Thiết lập kho hàng
            </div>
            <div class="card-body">
                @using (Html.BeginForm("QuanLySize", "Admin_65131148", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@hangHoa.maHangHoa" />

                    <div class="mb-4">
                        <label class="form-label fw-bold">Chọn loại sản phẩm:</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="coSize" id="optNoSize" value="false"
                                       @(!dangCoSize ? "checked" : "") onclick="toggleMode(false)">
                                <label class="form-check-label" for="optNoSize">
                                    Sản phẩm thường (Vợt, Balo, Phụ kiện...)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="coSize" id="optHasSize" value="true"
                                       @(dangCoSize ? "checked" : "") onclick="toggleMode(true)">
                                <label class="form-check-label" for="optHasSize">
                                    Sản phẩm có Size (Giày, Quần áo...)
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div id="divNoSize" class="@(dangCoSize ? "d-none" : "")">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nhập tổng số lượng tồn kho</label>
                            <input type="number" name="soLuongChung" class="form-control form-control-lg border-primary"
                                   value="@hangHoa.soLuongTon" min="0" placeholder="Ví dụ: 100" />
                            <div class="form-text">Nhập trực tiếp số lượng cho sản phẩm này.</div>
                        </div>
                    </div>

                    <div id="divHasSize" class="@(!dangCoSize ? "d-none" : "")">
                        <div class="alert alert-info small mb-3">
                            <i class="bi bi-info-circle"></i> Nhập số lượng cho từng size. Hệ thống sẽ tự cộng tổng.
                        </div>
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-bordered align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th class="text-center" width="30%">Size</th>
                                        <th>Số lượng tồn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var size in Model)
                                    {
                                        var sizeDaCo = existingSizes.FirstOrDefault(x => x.maSize == size.maSize);
                                        int sl = sizeDaCo != null ? sizeDaCo.soLuongTon : 0;
                                        <tr>
                                            <td class="text-center fw-bold bg-light">
                                                @size.tenSize
                                                <input type="hidden" name="maSize" value="@size.maSize" />
                                            </td>
                                            <td>
                                                <input type="number" name="soLuongRieng" class="form-control"
                                                       value="@sl" min="0" placeholder="0" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="bi bi-save me-2"></i> Cập nhật kho
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function toggleMode(hasSize) {
        var divNoSize = document.getElementById('divNoSize');
        var divHasSize = document.getElementById('divHasSize');

        if (hasSize) {
            divNoSize.classList.add('d-none');
            divHasSize.classList.remove('d-none');
        } else {
            divNoSize.classList.remove('d-none');
            divHasSize.classList.add('d-none');
        }
    }
</script>