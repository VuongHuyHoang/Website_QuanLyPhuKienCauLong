@model IEnumerable<WebsiteBanPhuKienCauLong_65131148.Models.Size>
@{
    ViewBag.Title = "Quản lý Size";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-dark"><i class="bi bi-rulers me-2"></i>Quản lý Kích cỡ (Size)</h4>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="bg-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên Size</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.maSize</td>
                                <td><span class="badge bg-secondary fs-6">@item.tenSize</span></td>
                                <td>
                                    <a href="@Url.Action("XoaSize", new { id = item.maSize })"
                                       class="btn btn-sm btn-outline-danger border-0"
                                       onclick="return confirm('Xóa size này?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-center py-3">
                    <nav>
                        <ul class="pagination mb-0">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("DanhSachSize", new { page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">Thêm nhanh</div>
            <div class="card-body">
                <form action="@Url.Action("TaoSize")" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Tên Size (VD: 40, XL...)</label>
                        <input type="text" name="tenSize" class="form-control" required placeholder="Nhập tên size..." />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Lưu lại</button>
                </form>
            </div>
        </div>
    </div>
</div>