@model WebsiteBanPhuKienCauLong_65131148.Models.HangHoa
@{
    ViewBag.Title = "Thêm sản phẩm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a href="@Url.Action("DanhSachSanPham")" class="btn btn-light border rounded-circle me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold m-0">Thêm sản phẩm mới</h4>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                @using (Html.BeginForm("TaoSanPham", "Admin_65131148", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                            @Html.EditorFor(model => model.tenHangHoa, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." } })
                            @Html.ValidationMessageFor(model => model.tenHangHoa, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá bán (VNĐ)</label>
                            @Html.EditorFor(model => model.gia, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục</label>
                            @Html.DropDownList("maDanhMuc", null, htmlAttributes: new { @class = "form-select" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thương hiệu (Hãng)</label>
                            @Html.DropDownList("maHang", null, htmlAttributes: new { @class = "form-select" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Hình ảnh đại diện</label>
                        <input type="file" name="anhFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số lượng tồn kho (Mặc định)</label>
                        @Html.EditorFor(model => model.soLuongTon, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        <div class="form-text text-muted">Nếu sản phẩm có nhiều size, vui lòng cấu hình size sau khi tạo.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mô tả chi tiết</label>
                        @Html.TextAreaFor(model => model.moTa, new { @class = "form-control", rows = "5" })
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("DanhSachSanPham")" class="btn btn-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu sản phẩm</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>