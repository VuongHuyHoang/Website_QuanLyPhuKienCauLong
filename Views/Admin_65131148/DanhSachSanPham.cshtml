@model IEnumerable<WebsiteBanPhuKienCauLong_65131148.Models.HangHoa>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center gap-3">
                <h5 class="fw-bold text-dark m-0 text-nowrap">
                    <i class="bi bi-box-seam me-2"></i>Sản phẩm
                </h5>

                <form method="get" action="@Url.Action("DanhSachSanPham")" class="d-flex gap-2">

                    @Html.DropDownList("maDanhMuc", (SelectList)ViewBag.maDanhMuc, "-- Danh mục --",
                        new { @class = "form-select form-select-sm", style = "width: 150px;", onchange = "this.form.submit()" })

                    @Html.DropDownList("maHang", (SelectList)ViewBag.maHang, "-- Thương hiệu --",
                        new { @class = "form-select form-select-sm", style = "width: 150px;", onchange = "this.form.submit()" })

                    <select name="sortOrder" class="form-select form-select-sm" style="width: 160px;" onchange="this.form.submit()">
                        <option value="">-- Sắp xếp --</option>
                        <option value="gia_tang" @(ViewBag.SortOrder == "gia_tang" ? "selected" : "")>Giá: Thấp -> Cao</option>
                        <option value="gia_giam" @(ViewBag.SortOrder == "gia_giam" ? "selected" : "")>Giá: Cao -> Thấp</option>
                        <option value="ten_az" @(ViewBag.SortOrder == "ten_az" ? "selected" : "")>Tên: A -> Z</option>
                    </select>

                    <a href="@Url.Action("DanhSachSanPham")" class="btn btn-sm btn-light border" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </form>
            </div>

            <div>
                <a href="@Url.Action("TaoSanPham")" class="btn btn-primary btn-sm fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm mới
                </a>
            </div>
        </div>
    </div>
</div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá bán</th>
                            <th>Danh mục</th>
                            <th>Hãng</th>
                            <th class="text-center">Tồn kho</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <img src="~/images/@item.anh" class="rounded border" style="width: 45px; height: 45px; object-fit: contain; background: #fff;" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.tenHangHoa</div>
                                        <small class="text-muted">ID: #@item.maHangHoa</small>
                                    </td>
                                    <td class="text-danger fw-bold">@((item.gia ?? 0).ToString("N0")) đ</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">@item.DanhMuc.tenDanhMuc</span></td>
                                    <td>@item.Hang.tenHang</td>
                                    <td class="text-center">
                                        @if (item.soLuongTon > 5)
                                        {
                                            <span class="fw-bold text-success">@item.soLuongTon</span>
                                        }
                                        else if (item.soLuongTon > 0)
                                        {
                                            <span class="fw-bold text-warning">@item.soLuongTon</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="@Url.Action("QuanLySize", new { id = item.maHangHoa })" class="btn btn-sm btn-link text-primary p-0 mx-1" title="Cấu hình tồn kho">
                                            <i class="bi bi-gear-fill fs-5"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = item.maHangHoa })" class="btn btn-sm btn-link text-warning p-0 mx-1" title="Sửa">
                                            <i class="bi bi-pencil-square fs-5"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.maHangHoa })" class="btn btn-sm btn-link text-danger p-0 mx-1" title="Xóa">
                                            <i class="bi bi-trash-fill fs-5"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Không tìm thấy sản phẩm nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSachSanPham", new { page = ViewBag.CurrentPage - 1, maDanhMuc = ViewBag.CurrentDanhMuc, maHang = ViewBag.CurrentHang, sortOrder = ViewBag.SortOrder })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DanhSachSanPham", new { page = i, maDanhMuc = ViewBag.CurrentDanhMuc, maHang = ViewBag.CurrentHang, sortOrder = ViewBag.SortOrder })">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSachSanPham", new { page = ViewBag.CurrentPage + 1, maDanhMuc = ViewBag.CurrentDanhMuc, maHang = ViewBag.CurrentHang, sortOrder = ViewBag.SortOrder })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
