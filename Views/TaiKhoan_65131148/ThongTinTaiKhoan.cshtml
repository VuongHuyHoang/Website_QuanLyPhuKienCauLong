@using WebsiteBanPhuKienCauLong_65131148.Models
@model WebsiteBanPhuKienCauLong_65131148.Models.KhachHang
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";

    // 🔥 Lấy danh sách sản phẩm đã mua từ Controller gửi sang
    var spDaMua = ViewBag.SanPhamDaMua as List<HangHoa>;
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body text-center py-5">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary fw-bold mb-3"
                         style="width: 100px; height: 100px; font-size: 40px;">
                        @Model.hoTen.Substring(0, 1).ToUpper()
                    </div>

                    <h5 class="fw-bold mb-1">@Model.hoTen</h5>
                    <p class="text-muted small mb-3">@Model.email</p>

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("DonHang", "HangHoas_65131148")" class="btn btn-outline-primary rounded-pill">
                            <i class="bi bi-bag-check me-2"></i>Đơn hàng của tôi
                        </a>
                        <a href="@Url.Action("DangXuat", "TaiKhoan_65131148")" class="btn btn-light text-danger rounded-pill">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                    <ul class="nav nav-tabs card-header-tabs" id="accountTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active fw-bold" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">
                                <i class="bi bi-person-gear me-2"></i>Hồ sơ cá nhân
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="products-tab" data-bs-toggle="tab" data-bs-target="#products" type="button" role="tab">
                                <i class="bi bi-bag-heart-fill me-2"></i>Sản phẩm đã mua
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link fw-bold" id="password-tab" data-bs-toggle="tab" data-bs-target="#password" type="button" role="tab">
                                <i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="accountTabsContent">

                        <div class="tab-pane fade show active" id="profile" role="tabpanel">
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                                </div>
                            }

                            <form action="@Url.Action("CapNhatThongTin")" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maKhachHang" value="@Model.maKhachHang" />

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted">Họ và tên</label>
                                        <input type="text" name="hoTen" value="@Model.hoTen" class="form-control" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted">Email (Không thể thay đổi)</label>
                                        <input type="email" value="@Model.email" class="form-control bg-light" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-muted">Số điện thoại</label>
                                        <input type="text" name="sdt" value="@Model.sdt" class="form-control" />
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label small fw-bold text-muted">Địa chỉ nhận hàng</label>
                                        <input type="text" name="diaChi" value="@Model.diaChi" class="form-control" />
                                    </div>
                                </div>

                                <div class="mt-4 text-end">
                                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                        Lưu thay đổi
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="tab-pane fade" id="products" role="tabpanel">
                            @if (spDaMua != null && spDaMua.Any())
                            {
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white py-3">
                                        <h5 class="fw-bold m-0">Lịch sử mua hàng</h5>
                                    </div>

                                    <div class="card-body p-0">
                                        <div class="list-group list-group-flush" id="productListContainer">
                                            @foreach (var sp in spDaMua)
                                            {
                                                <div class="list-group-item px-3 py-3 align-items-center product-item" style="display: none;">
                                                    <div class="me-3 position-relative">
                                                        <img src="~/images/@sp.anh" class="rounded border" style="width: 70px; height: 70px; object-fit: cover;" />
                                                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-light rounded-circle">
                                                            <span class="visually-hidden">Đã mua</span>
                                                        </span>
                                                    </div>

                                                    <div class="flex-grow-1">
                                                        <h6 class="fw-bold mb-1 text-dark">
                                                            <a href="@Url.Action("Details", "HangHoas_65131148", new { id = sp.maHangHoa })" class="text-decoration-none text-dark">
                                                                @sp.tenHangHoa
                                                            </a>
                                                        </h6>
                                                        <small class="text-muted d-block mb-1">Đã mua thành công</small>
                                                    </div>

                                                    <div class="ms-3">
                                                        <a href="@Url.Action("Details", "HangHoas_65131148", new { id = sp.maHangHoa })#review-section"
                                                           class="btn btn-sm btn-outline-warning rounded-pill fw-bold">
                                                            <i class="bi bi-star-fill me-1"></i> Đánh giá
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="card-footer bg-white py-3">
                                        <nav>
                                            <ul class="pagination justify-content-center mb-0" id="paginationControls">
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-cart-x fs-1 text-muted opacity-50"></i>
                                    <p class="mt-3 text-muted fw-bold">Bạn chưa mua đơn hàng nào thành công.</p>
                                    <a href="@Url.Action("TrangSanPham", "HangHoas_65131148")" class="btn btn-primary btn-sm rounded-pill px-4">
                                        Mua sắm ngay
                                    </a>
                                </div>
                            }
                        </div>

                        <div class="tab-pane fade" id="password" role="tabpanel">
                            @if (TempData["SuccessPass"] != null)
                            {
                                <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessPass"]
                                </div>
                            }
                            @if (TempData["ErrorPass"] != null)
                            {
                                <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorPass"]
                                </div>
                            }

                            <form action="@Url.Action("DoiMatKhau")" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maKhachHang" value="@Model.maKhachHang" />

                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">Mật khẩu hiện tại</label>
                                    <input type="password" name="matKhauCu" class="form-control" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-muted">Mật khẩu mới</label>
                                    <input type="password" name="matKhauMoi" class="form-control" required />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-muted">Xác nhận mật khẩu mới</label>
                                    <input type="password" name="xacNhanMatKhau" class="form-control" required />
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                                        Đổi mật khẩu
                                    </button>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Kiểm tra nếu có lỗi/thành công của Mật khẩu thì mở Tab Mật khẩu
        var hasPassError = '@(TempData["ErrorPass"] != null)' === 'True';
        var hasPassSuccess = '@(TempData["SuccessPass"] != null)' === 'True';

        if (hasPassError || hasPassSuccess) {
            var triggerEl = document.querySelector('#password-tab');
            var tab = new bootstrap.Tab(triggerEl);
            tab.show();
        }

        // 2. Kiểm tra Hash trên URL (ví dụ: #products) để mở tab tương ứng
        var hash = window.location.hash;
        if (hash) {
            // Tìm nút tab có data-bs-target trùng với hash
            var triggerEl = document.querySelector('button[data-bs-target="' + hash + '"]');
            if (triggerEl) {
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }
        }
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- CẤU HÌNH PHÂN TRANG ---
        const itemsPerPage = 4; // Số sản phẩm mỗi trang (Theo yêu cầu của bạn)
        const items = document.querySelectorAll('.product-item'); // Lấy tất cả sản phẩm
        const paginationContainer = document.getElementById('paginationControls');
        const totalItems = items.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        // Hàm hiển thị trang cụ thể
        function showPage(page) {
            // 1. Ẩn/Hiện sản phẩm
            const start = (page - 1) * itemsPerPage;
            const end = start + itemsPerPage;

            items.forEach((item, index) => {
                if (index >= start && index < end) {
                    item.style.display = 'flex'; // Dùng flex vì class gốc là d-flex
                } else {
                    item.style.display = 'none';
                }
            });

            // 2. Vẽ lại nút phân trang
            renderPaginationButtons(page);
        }

        // Hàm vẽ nút phân trang
        function renderPaginationButtons(currentPage) {
            paginationContainer.innerHTML = ''; // Xóa nút cũ

            // Nếu chỉ có 1 trang thì không cần hiện nút
            if (totalPages <= 1) return;

            // Nút Previous
            let prevClass = currentPage === 1 ? 'disabled' : '';
            paginationContainer.innerHTML += `
                <li class="page-item ${prevClass}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1}); return false;">&laquo;</a>
                </li>`;

            // Các nút số trang
            for (let i = 1; i <= totalPages; i++) {
                let activeClass = i === currentPage ? 'active' : '';
                paginationContainer.innerHTML += `
                    <li class="page-item ${activeClass}">
                        <a class="page-link" href="#" onclick="changePage(${i}); return false;">${i}</a>
                    </li>`;
            }

            // Nút Next
            let nextClass = currentPage === totalPages ? 'disabled' : '';
            paginationContainer.innerHTML += `
                <li class="page-item ${nextClass}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1}); return false;">&raquo;</a>
                </li>`;
        }

        // Hàm gọi từ nút bấm (gán vào window để HTML gọi được)
        window.changePage = function (page) {
            if (page < 1 || page > totalPages) return;
            showPage(page);
        }

        // Khởi chạy trang 1 nếu có sản phẩm
        if (totalItems > 0) {
            showPage(1);
        }
    });
</script>