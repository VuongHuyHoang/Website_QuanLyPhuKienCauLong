<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Thiên Hương Badminton</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Custom CSS -->
    <link href="~/Content/Main.css" rel="stylesheet" />

    <link rel="shortcut icon" type="image/x-icon" href="~/images/favicon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


</head>
<body>

    <!-- ===== HEADER ===== -->
    <header class="header sticky-top shadow-sm pb-0">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-between py-3">

                <div class="logo me-4">
                    <a href="@Url.Action("TrangChu","HangHoas_65131148")" class="text-decoration-none text-white fs-4 fw-bold d-flex align-items-center">
                        <span class="me-2" style="font-size: 1.5rem;">🏸</span>
                        <span class="d-none d-md-block">Thiên Hương Badminton</span>
                    </a>
                </div>

                <div class="search-box flex-grow-1 mx-lg-5 mx-3">
                    <form action="@Url.Action("TrangSanPham","HangHoas_65131148")" method="get">
                        <div class="input-group">
                            <input type="text"
                                   name="keyword"
                                   class="form-control border-0 py-2 px-3"
                                   placeholder="Tìm kiếm vợt, giày, phụ kiện..."
                                   aria-label="Search"
                                   style="border-radius: 20px 0 0 20px;">

                            <button type="submit" class="btn btn-warning border-0 text-dark fw-bold px-4"
                                    style="border-radius: 0 20px 20px 0;">
                                <i class="bi bi-search"></i> @* Dùng icon thay vì emoji *@
                            </button>
                        </div>
                    </form>
                </div>

                <div class="user-box d-flex align-items-center gap-3">

                    @* Nút Giỏ Hàng *@
                    <a href="@Url.Action("GioHang", "HangHoas_65131148")" class="position-relative text-white text-decoration-none fs-5">
                        <i class="bi bi-cart3"></i>
                        @* Nếu muốn hiện số lượng item, thêm badge ở đây *@
                    </a>

                    @if (Session["User"] == null)
                    {
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("DangNhap", "TaiKhoan_65131148")" class="btn btn-custom-login btn-sm rounded-pill px-3 ">
                                Đăng nhập
                            </a>

                            <a href="@Url.Action("DangKy", "Taikhoan_65131148")" class="btn btn-custom-register btn-sm rounded-pill px-3 fw-bold">
                                Đăng ký
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="d-none d-md-block fw-semibold">@Session["HoTen"]</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="border-radius: 10px; overflow: hidden;">
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("ThongTinTaiKhoan", "TaiKhoan_65131148")">
                                        <i class="bi bi-person-lines-fill me-2 text-primary"></i> Thông Tin Tài Khoản
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2" href="@Url.Action("DonHang", "HangHoas_65131148")">
                                        <i class="bi bi-bag-check me-2 text-primary"></i> Đơn hàng của tôi
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="@Url.Action("DangXuat", "TaiKhoan_65131148")">
                                        <i class="bi bi-box-arrow-in-right me-2 text-danger"></i> Đăng Xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- MENU -->
        <nav class="main-menu">
            <ul class="container mb-0">
                <li><a href="@Url.Action("TrangChu","HangHoas_65131148")">Trang chủ</a></li>
                <li><a href="@Url.Action("TrangSanPham","HangHoas_65131148")">Sản phẩm</a></li>
                <li><a href="@Url.Action("TrangGioiThieu","HangHoas_65131148")">Giới Thiệu</a></li>
                <li><a href="@Url.Action("TrangLienHe","HangHoas_65131148")">Liên Hệ</a></li>
            </ul>
        </nav>
    </header>

    <!-- ===== CONTENT ===== -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer mt-0">
        <div class="container footer-content">
            <div class="footer-col">
                <h4>Thiên Hương Badminton</h4>
                <p>
                    Chuyên phụ kiện cầu lông chính hãng<br />
                    Vợt – Giày – Cước – Túi – Phụ kiện
                </p>
            </div>

            <div class="footer-col">
                <h4>Liên kết</h4>
                <ul>
                    <li><a href="#">Giới thiệu</a></li>
                    <li><a href="#">Chính sách đổi trả</a></li>
                    <li><a href="#">Hướng dẫn mua hàng</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Liên hệ</h4>
                <p>📞 0386947823</p>
                <p>✉ support@badmintonshop.vn</p>
            </div>
        </div>

        <div class="footer-bottom">
            Vương Huy Hoàng - 65131148 - 65.CNTT-2
        </div>
    </footer>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Message"] != null)
{
    <script>
        Swal.fire({
            title: 'Thông báo',
            text: @Html.Raw(Json.Encode(TempData["Message"])),
            icon: '@TempData["MessageType"]',
            confirmButtonText: 'Đồng ý',
            timer: 3000
        });
    </script>
}
@RenderSection("Scripts", required: false)
</body>
</html>
